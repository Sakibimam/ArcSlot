\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"},{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"name\":\"slots\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address[]\",\"name\":\"slotAddresses\",\"type\":\"address[]\"}],\"name\":\"sweepMany\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"tip\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"usdc\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"errors\":{\"FailedDeployment()\":[{\"details\":\"The deployment failed.\"}],\"InsufficientBalance(uint256,uint256)\":[{\"details\":\"The ETH balance of the account is not enough to perform the operation.\"}]},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"_implementation\":\"Address of the deployed Slot implementation.\",\"_minSweep\":\"Minimum gross balance required to trigger sweep.\",\"_tip\":\"Flat caller bonus in 6-decimal USDC units.\",\"_usdc\":\"ERC-20 USDC token address (non-zero).\"}},\"createSlot(address,bytes32,uint16,address,uint256)\":{\"params\":{\"feeBps\":\"Fee in basis points (0-1000, i.e. 0-10%).\",\"feeRecipient\":\"Receives the fee portion; must be non-zero when feeBps > 0.\",\"maxReimbursement\":\"Cap on a stranger sweeper's gas refund + tip                      (6-decimal USDC); must be >= tip.\",\"merchant\":\"Address that will receive swept USDC.\",\"payRef\":\"Off-chain payment reference; unique per merchant.\"},\"returns\":{\"slot\":\"        Address of the newly-deployed Slot clone.\"}},\"sweepMany(address[])\":{\"params\":{\"slot