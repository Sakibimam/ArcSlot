type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"usdc\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"errors\":{\"FailedDeployment()\":[{\"details\":\"The deployment failed.\"}],\"InsufficientBalance(uint256,uint256)\":[{\"details\":\"The ETH balance of the account is not enough to perform the operation.\"}]},\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"_implementation\":\"Address of the deployed Slot implementation.\",\"_minSweep\":\"Minimum gross balance required to trigger sweep.\",\"_tip\":\"Flat caller bonus in 6-decimal USDC units.\",\"_usdc\":\"ERC-20 USDC token address (non-zero).\"}},\"createSlot(address,bytes32,uint16,address)\":{\"params\":{\"feeBps\":\"Fee in basis points (0-1000, i.e. 0-10%).\",\"feeRecipient\":\"Receives the fee portion; must be non-zero when feeBps > 0.\",\"merchant\":\"Address that will receive swept USDC.\",\"payRef\":\"Off-chain payment reference; unique per merchant.\"},\"returns\":{\"slot\":\"        Address of the newly-deployed Slot clone.\"}},\"sweepMany(address[])\":{\"params\":{\"slotAddresses\":\"Array of Slot clone addresses to sweep.\"}}},\"stateVariables\":{\"slots\":{\"details\":\"merchant => payRef => slot address (non-zero once deployed).\"}},\"title\":\"SlotFactory\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"createSlot(address,bytes32,uint16,address)\":{\"notice\":\"Deploy a new Slot clone for (merchant, payRef).\"},\"implementation()\":{\"notice\":\"EIP-1167 implementation address.  All clones proxy to this.\"},\"minSweep()\":{\"notice\":\"Minimum gross balance (6-decimal USDC) required to sweep,         forwarded to every clone.\"},\"predict(address,bytes32)\":{\"notice\":\"Predict the deterministic address for (merchant, payRef)         without deploying. Returns the same address createSlot would produce.\"},\"sweepMany(address[])\