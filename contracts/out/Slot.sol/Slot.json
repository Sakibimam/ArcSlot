2;3702:60;;3758:1;3755;3748:12","linkReferences":{}},"methodIdentifiers":{"balance()":"b69ef8a8","feeBps()":"24a9d853","feeRecipient()":"46904840","initialize(address,bytes32,uint16,address)":"c62206f7","merchant()":"a5ff7651","payRef()":"b726bc47","quarantined()":"07d9336e","resolveQuarantine(address)":"6dd2714a","sweep()":"35faa416"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[],\"name\":\"AlreadyInitialised\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"FeeBpsTooHigh\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NotMerchant\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NotQuarantined\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NothingToSweep\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ReentrancyGuardReentrantCall\",\"type\":\"error\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"}],\"name\":\"SafeERC20FailedOperation\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ZeroFeeRecipient\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ZeroMerchant\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"slot\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"payRef_\",\"type\":\"bytes32\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"who\",\"type\":\"address\"}],\"name\":\"Quarantined\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"payRef_\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"gross\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"net\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"fee\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"reimbursement\",\"type\":\"uint256\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"sweeper\",\"type\":\"address\"}],\"name\":\"Received\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"balance\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"feeBps\",\"outputs\":[{\"internalType\":\"uint16\",\"name\":\"\",\"type\":\"uint16\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"feeRecipient\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_merchant\",\"type\":\"address\"},{\"internalType\":\"bytes32\",\"name\":\"_payRef\",\"type\":\"bytes32\"},{\"internalType\":\"uint16\",\"name\":\"_feeBps\",\"type\":\"uint16\"},{\"internalType\":\"address\",\"name\":\"_feeRecipient\",\"type\":\"address\"}],\"name\":\"initialize\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"merchant\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"payRef\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"quarantined\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newMerchant\",\"type\":\"address\"}],\"name\":\"resolveQuarantine\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"sweep\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"errors\":{\"ReentrancyGuardReentrantCall()\":[{\"details\":\"Unauthorized reentrant call.\"}],\"SafeERC20FailedOperation(address)\":[{\"details\":\"An operation with an ERC-20 token failed.\"}]},\"events\":{\"Quarantined(address,bytes32,address)\":{\"params\":{\"payRef_\":\"Payment reference.\",\"slot\":\"Address of this Slot clone.\",\"who\":\"The blacklisted address that triggered quarantine.\"}},\"Received(bytes32,uint256,uint256,uint256,uint256,address)\":{\"params\":{\"fee\":\"Amount forwarded to feeRecipient.\",\"gross\":\"Total USDC balance swept.\",\"net\":\"Amount forwarded to merchant.\",\"payRef_\":\"Payment reference for this slot.\",\"reimbursement\":\"Amount forwarded to the caller (gas refund + tip).\",\"sweeper\":\"Address that called sweep().\"}}},\"kind\":\"dev\",\"methods\":{\"resolveQuarantine(address)\":{\"params\":{\"newMerchant\":\"Non-zero replacement merchant address.\"}}},\"stateVariables\":{\"FIXED_OVERHEAD\":{\"details\":\"Covers intrinsic gas (21 000) + calldata + the bookkeeping inside      sweep() that runs before and after the gasleft() snapshot.      Calibrated conservatively high so callers are never under-paid.\"},\"TIP\":{\"details\":\"Flat bonus added on top of the gas reimbursement (6-decimal USDC).      0.01 USDC \\u2014 large enough that integer-division truncation in      gasCost18 / 1e12 can never eat the caller's surplus.\"},\"USDC\":{\"details\":\"ERC-20 USDC on Arc (6 decimals). Only this interface is used.\"},\"quarantined\":{\"details\":\"Set when sweep() detects a blacklisted merchant or feeRecipient.      Cleared by resolveQuarantine().\"}},\"title\":\"Slot\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"balance()\":{\"notice\":\"ERC-20 USDC balance of this slot (6-decimal units).\"},\"initialize(address,bytes32,uint16,address)\":{\"notice\":\"Called exactly once by SlotFactory immediately after cloning.\"},\"resolveQuarantine(address)\":{\"notice\":\"Called by the original merchant to resolve a quarantine.         `newMerchant` replaces the current merchant so that a         subsequently clean sweep can succeed. This is the ONLY function         that may change the merchant, and only from the quarantined state.\"},\"sweep()\":{\"notice\":\"Permissionless sweep. Forwards USDC to merchant and feeRecipient,         reimbursing the caller for gas (in USDC) plus a flat tip.         Checks-Effects-Interactions order:           1. Checks  : balance, blacklist           2. Effects : (quarantine flag written if needed)           3. Interactions : SafeERC20 transfers         ReentrancyGuard prevents a reentrant call between transfers.\"}},\"notice\":\"A minimal deposit-address clone in the Arc Slot system.         Arc specifics honoured throughout:         - USDC is the native gas token AND an ERC-20 at ARC_USDC_ADDRESS.           We use ONLY the 6-decimal ERC-20 view; msg.value is never read.         - Transfers to address(0) revert on Arc, so all zero-address paths           are rejected at initialisation time.         - No SELFDESTRUCT anywhere (would drain the contract's native           balance and leave a broken address).         - Nothing is payable.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/Slot.sol\":\"Slot\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/Slot.sol\":{\"keccak256\":\"0x73b7d403d95134f85fb6924823866f23239125b968acfdeddcc1a815bd9add89\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://fabd4496a6bec004f3e16702489254bef80d06651002007a4c8d523f201ff1e3\",\"dweb:/ipfs/QmX3Qg2UD8bzjnch9r8JdqkUjanrSJdQNMzxxpeBckNdXe\"]},\"node_modules/@openzeppelin/contracts/interfaces/IERC1363.sol\":{\"keccak256\":\"0xd5ea07362ab630a6a3dee4285a74cf2377044ca2e4be472755ad64d7c5d4b69d\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://da5e832b40fc5c3145d3781e2e5fa60ac2052c9d08af7e300dc8ab80c4343100\",\"dweb:/ipfs/QmTzf7N5ZUdh5raqtzbM11yexiUoLC9z3Ws632MCuycq1d\"]},\"node_modules/@openzeppelin/contracts/interfaces/IERC165.sol\":{