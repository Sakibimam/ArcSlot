entrantCall()\":[{\"details\":\"Unauthorized reentrant call.\"}],\"SafeERC20FailedOperation(address)\":[{\"details\":\"An operation with an ERC-20 token failed.\"}]},\"events\":{\"Quarantined(address,bytes32,address)\":{\"params\":{\"payRef_\":\"Payment reference.\",\"slot\":\"Address of this Slot clone.\",\"who\":\"The blacklisted address that triggered quarantine                (address(0) when the quarantine was triggered by a                probe failure rather than a confirmed blacklisting).\"}},\"QuarantinedCheckFailed(address,bytes32)\":{\"details\":\"Emitted when the isBlacklisted() probe itself fails (call-level        error or unexpected return data). The slot is quarantined fail-        closed rather than proceeding as if the addresses were clear.\",\"params\":{\"payRef_\":\"Payment reference.\",\"slot\":\"Address of this Slot clone.\"}},\"Received(bytes32,uint256,uint256,uint256,uint256,address)\":{\"params\":{\"fee\":\"Amount forwarded to feeRecipient.\",\"gross\":\"Total USDC balance swept.\",\"net\":\"Amount forwarded to merchant.\",\"payRef_\":\"Payment reference for this slot.\",\"reimbursement\":\"Amount forwarded to the caller (gas refund + tip).\",\"sweeper\":\"Address that called sweep().\"}}},\"kind\":\"dev\",\"methods\":{\"initialize(address,uint256,uint256,address,bytes32,uint16,address)\":{\"params\":{\"_feeBps\":\"Fee in basis points (0-1000).\",\"_feeRecipient\":\"Fee recipient (non-zero when _feeBps > 0).\",\"_merchant\":\"Merchant payout address (non-zero).\",\"_minSweep\":\"Minimum gross balance required to trigger a sweep.\",\"_payRef\":\"Off-chain payment reference (bytes32).\",\"_tip\":\"Flat caller bonus in 6-decimal USDC units.\",\"_usdc\":\"ERC-20 USDC token address (non-zero).\"}},\"resolveQuarantine(address,address,uint16)\":{\"params\":{\"newFeeBps\":\"Replacement fee in basis points (0-1000).\",\"newFeeRecipient\":\"Replacement fee recipient (zero is valid when                         newFeeBps == 0, disabling the fee path entirely).\",\"newMerchant\":\"Replacement merchant address (non-zero).\"}}},\"stateVariables\":{\"FIXED_OVERHEAD\":{\"details\":\"Covers intrinsic gas (21 000) + calldata + the bookkeeping inside      sweep() that runs before and after the gasleft() snapshot.      Calibrated conservatively high so callers are never under-paid.\"},\"quarantined\":{\"details\":\"Set when sweep() detects a blacklisted payout address or a      failed isBlacklisted probe. Cleared by resolveQuarantine().\"}},\"title\":\"Slot\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"balance()\":{\"notice\":\"ERC-20 USDC balance of this slot (6-decimal units).\"},\"initialize(address,uint256,uint256,address,bytes32,uint16,address)\":{\"notice\":\"Called exactly once by SlotFactory immediately after cloning.\"},\"minSweep()\":{\"notice\":\"Minimum gross balance (6-decimal USDC) required before         sweep() will distribute funds.  Prevents dust sweeps.\"},\"resolveQuarantine(address,address,uint16)\":{\"notice\":\"Called by the current merchant to resolve a quarantine.         Allows replacing BOTH the merchant and the feeRecipient so that         a subsequent sweep can succeed regardless of which address caused         the quarantine. This is the ONLY function that may change merchant         or feeRecipient, and only from the quarantined state.         Validation mirrors initialize():         - newMerchant must be non-zero.         - If newFeeBps > 0 then newFeeRecipient must be non-zero.         - newFeeBps must be <= 1000.\"},\"sweep()\":{\"notice\":\"Permissionless sweep. Forwards USDC to merchant and feeRecipient,         reimbursing the caller for gas (in USDC) plus a flat tip.         Checks-Effects-Interactions order:           1. Checks       : balance, minSweep, blacklist probes           2. Effects      : quarantine flag written if needed           3. Interactions : SafeERC20 transfers, then event         ReentrancyGuard prevents a reentrant call between transfers.\"},\"tip()\":{\"notice\":\"Flat caller tip in 6-decimal USDC units added on top of the         gas reimbursement.  Set by SlotFactory at initialisation.\"},\"usdc()\":{\"notice\":\"ERC-20 USDC token for this slot (6-decimal interface only).\"}},\"notice\":\"A minimal deposit-address clone in the Arc Slot system.         Arc specifics honoured throughout:         - USDC is the native gas token AND an ERC-20.  We use ONLY the           6-decimal ERC-20 view; msg.value is never read.         - Transfers to address(0) revert on Arc, so all zero-address           paths are rejected at initialisation time.         - No SELFDESTRUCT anywhere (would drain the contract's native           balance and leave a broken address).         - Nothing is payable.         The implementation is deployed once; SlotFactory deploys EIP-1167         minimal proxies and calls initialize() on each clone.  USDC, TIP,         and MIN_SWEEP are supplied at initialisation time so the factory         can be configured per-operator without redeploying the         implementation.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/Slot.sol\":\"Slot\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/Slot.sol\":{\"keccak256\":\"0x16dccff42b33bee8e8ff208f27eaf6a0101340e69d5570728f1b43da92525d3c\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://c0a987783ee0c1b7fd2bab831bc466659fd9ce77f306d1af609b3681141375a8\",\"dweb:/ipfs/QmRutTkX1MmncysHifhF1iyo3V1w7pbwpfZgNZQqemjrF5\"]},\"node_modules/@openzeppelin/contracts/interfaces/IERC1363.sol\":{\"keccak256\":\"0xd5ea07362ab630a6a3dee4285a74cf2377044ca2e4be472755ad64d7c5d4b69d\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://da5e832b40fc5c3145d3781e2e5fa60ac2052c9d08af7e300dc8ab80c4343100\",\"dweb:/ipfs/QmTzf7N5ZUdh5raqtzbM11yexiUoLC9z3Ws632M