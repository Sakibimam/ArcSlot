{
  "name": "studio-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:self": "bun run ./scripts/self-deploy.ts",
    "compass:deploy": "bun run ./scripts/compass-deploy.ts",
    "fetch:abi": "bun run ./scripts/fetch-abi.ts",
    "lint": "oxlint --type-aware src scripts --fix; s=$?; oxlint --fix .; exit $((s>0?s:$?))",
    "typecheck": "tsc --noEmit",
    "check": "bash scripts/check.sh",
    "contracts:build": "forge build",
    "contracts:test": "forge test --no-match-path 'contracts/test-{integration,stress}/*'",
    "contracts:test:stress": "forge test --gas-limit 9000000000000 --match-path 'contracts/test-stress/*'",
    "stress:local": "bun scripts/stress-local.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:test:fork": "arc-forge test --ffi --match-path 'contracts/test-integration/*' --fork-url https://rpc.mainnet.arc.io",
    "test:all": "bun run contracts:test && bun run contracts:test:fork && bun run test && bun run typecheck && bun run build",
    "abis": "forge build && bun run ./scripts/gen-abis.ts",
    "test:e2e:ui": "node scripts/e2e-ui.mjs",
    "test:e2e:chain": "bash scripts/e2e-live.sh",
    "test:e2e:crosschain": "node scripts/e2e-ui-crosschain.mjs",
    "test:e2e:recovery": "node scripts/e2e-ui-recovery.mjs",
    "deploy:deterministic": "bash scripts/deploy-deterministic.sh",
    "watch:vault": "bun scripts/vault-watch.ts",
    "collect": "bun scripts/collector.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.3",
    "@circle-fin/app-kit": "^1.19.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.1",
    "@circle-fin/modular-wallets-core": "^1.0.16",
    "@circle-fin/smart-contract-platform": "^10.8.1",
    "@circle-fin/user-controlled-wallets": "^10.8.1",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "^5.104.5",
    "@web3icons/react": "^4.1.24",
    "clsx": "^2.1.1",
    "connectkit": "^1.9.2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "viem": "2.57.5",
    "wagmi": "^2.19.5"
  },
  "overrides": {
    "viem": "2.57.5",
    "undici": "^6.21.1",
    "@grpc/grpc-js": "^1.13.6"
  },
  "devDependencies": {
    "@noble/post-quantum": "0.7.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^6.4.5",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^4.1.11"
  }
}
